PREFIX p510: <http://www.lotar.org/schemas/mbse/p510#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?scenarioId ?verLevel ?valLevel ?tipoEnlace ?targetId
WHERE {
  ?manifest rdf:type p510:P510_ManifestType ;
            p510:has_Requirements_Verification_Validation ?vnv .
  ?vnv p510:Scenario ?sc .
  ?sc p510:Id ?scenarioId .
  OPTIONAL { ?sc p510:Verification_Credibility_Level ?verLevel }
  OPTIONAL { ?sc p510:Validation_Credibility_Level ?valLevel }

  OPTIONAL {
    {
      ?sc p510:Verified_by ?link .
      BIND("Verified_by" AS ?tipoEnlace)
    }
    UNION
    {
      ?sc p510:Validated_by ?link .
      BIND("Validated_by" AS ?tipoEnlace)
    }

    ?link p510:Link ?target .
    OPTIONAL { ?target p510:Id ?targetId }
  }
}
ORDER BY ?scenarioId
