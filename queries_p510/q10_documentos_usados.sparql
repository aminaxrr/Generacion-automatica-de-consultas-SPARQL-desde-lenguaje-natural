PREFIX p510: <http://www.lotar.org/schemas/mbse/p510#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?doc ?desc
WHERE {
  ?manifest rdf:type p510:P510_ManifestType ;
            p510:has_RequirementsDevStructure ?dev .
  ?dev p510:uses ?link .
  ?link a p510:Traceability_Link_Type ;
        p510:ContentType "Document" ;
        p510:Link ?doc .
  OPTIONAL { ?doc p510:Description ?desc }
}
