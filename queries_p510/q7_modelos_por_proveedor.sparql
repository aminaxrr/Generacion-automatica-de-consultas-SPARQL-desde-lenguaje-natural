PREFIX p510: <http://www.lotar.org/schemas/mbse/p510#>
PREFIX ex: <http://example.org/tfg/mbse#>

SELECT ?prov (COUNT(DISTINCT ?modelo) AS ?numModelos)
WHERE {
  ?modelo a p510:DesignModel ;
          p510:ContentType "Physical Model" ;
          ex:providedBy ?prov .
}
GROUP BY ?prov
ORDER BY DESC(?numModelos)
