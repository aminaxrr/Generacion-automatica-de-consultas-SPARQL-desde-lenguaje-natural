PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX p510: <http://www.lotar.org/schemas/mbse/p510#>

# Requisitos que NO llegan a test a través de modelo físico
SELECT ?req ?id
WHERE {
  ?req rdf:type p510:Requirement ;
       p510:Id ?id .

  FILTER NOT EXISTS {
    ?req p510:Satisfied_by ?l1 .
    ?l1 p510:ContentType "Physical Model" ;
        p510:Link ?modelo .

    ?modelo p510:Verified_by ?l2 .
    ?l2 p510:ContentType "Test Case" ;
        p510:Link ?test .
  }
}
